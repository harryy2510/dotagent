{
  "name": "dotagent-site",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "cd .. && site/node_modules/.bin/vp config --hooks --no-agent",
    "dev": "vp dev --host 127.0.0.1",
    "build": "bun run build.ts",
    "check": "vp check . \"$(dirname \"$PWD\")/README.md\" \"$(dirname \"$PWD\")/.agentsync/README.md\" \"$(dirname \"$PWD\")/.github/workflows/pages.yml\" && vp test",
    "fix": "vp check --fix . \"$(dirname \"$PWD\")/README.md\" \"$(dirname \"$PWD\")/.agentsync/README.md\" \"$(dirname \"$PWD\")/.github/workflows/pages.yml\"",
    "preview": "vp preview --host 127.0.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "vite-plus": "1.0.0"
  }
}
